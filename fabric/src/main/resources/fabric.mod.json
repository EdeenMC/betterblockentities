{
  "schemaVersion": 1,
  "id": "betterblockentities",
  "version": "${version}",

  "name": "Better Block Entities",
  "description": "Optimize and customize block entity rendering with a more modern approach.",
  "authors": [
    "ceeden"
  ],
  "contact": {
    "homepage": "https://github.com/ceeden/betterblockentities",
    "issues": "https://github.com/ceeden/betterblockentities/issues",
    "sources": "https://github.com/ceeden/betterblockentities"
  },

  "license": "LGPLv3",
  "icon": "assets/betterblockentities/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "betterblockentities.client.BBEFabric"
    ],
    "sodium:config_api_user": [
      "betterblockentities.client.gui.config.builder.SodiumConfigBuilder"
    ]
  },
  "mixins": [
    "betterblockentities-common.mixins.json",
    "betterblockentities-fabric.mixins.json"
  ],
  "accessWidener": "betterblockentities-fabric.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.7",
    "minecraft": ">=26.2",
    "sodium": ">=0.9.0"
  },
  "breaks": {
    "optifabric": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/better-block-entities",
        "modmenu.modrinth": "https://modrinth.com/mod/better-block-entities",
        "modmenu.discord": "https://discord.gg/NdX9BYpTtz"
      }
    }
  }
}
